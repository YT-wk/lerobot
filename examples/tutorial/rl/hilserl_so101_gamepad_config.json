{
  "env": {
    "type": "gym_manipulator",
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "COM_FOLLOWER",
      "id": "so101_follower_hil",
      "use_degrees": true,
      "max_relative_target": 5.0,
      "cameras": {}
    },
    "teleop": {
      "type": "gamepad",
      "use_gripper": true
    },
    "processor": {
      "control_mode": "gamepad",
      "gripper": {"use_gripper": true, "gripper_penalty": 0.0},
      "reset": {
        "fixed_reset_joint_positions": null,
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "path/to/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [0.16, -0.08, 0.03],
          "max": [0.24, 0.2, 0.1]
        },
        "end_effector_step_sizes": {"x": 0.01, "y": 0.01, "z": 0.01}
      },
      "max_gripper_pos": 100.0
    }
  },
  "dataset": {
    "repo_id": "your-org/so101_hil_gamepad",
    "task": "your_task",
    "root": "data/so101_hil_gamepad",
    "num_episodes_to_record": 20,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
