{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/ttyACM0",
      "id": "follower_arm_1",
      "use_degrees": true,
      "max_relative_target": 2.0,
      "cameras": {
        "side": {
          "type": "opencv",
          "index_or_path": "/dev/video0",
          "width": 640,
          "height": 480,
          "fps": 30,
          "backend": 200
        },
        "wrist": {
          "type": "opencv",
          "index_or_path": "/dev/video2",
          "width": 640,
          "height": 480,
          "fps": 30,
          "backend": 200
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/ttyACM1",
      "id": "leader_arm_1",
      "use_degrees": true
    },
    "processor": {
      "control_mode": "leader",
      "leader_control_strategy": "current",
      "leader_policy_tracking_enabled": false,
      "leader_follow_max_joint_speed_deg_s": 30.0,
      "leader_follow_max_gripper_speed": 60.0,
      "leader_gripper_open_on_positive_delta": false,
      "wenruo_kinematics": {
        "robot_model": "so_new_calibration",
        "frame": "gripper_tip",
        "max_iterations": 5,
        "learning_rate": 1.0,
        "position_tolerance_m": 0.005,
        "end_effector_bounds": {"min": [0.15, -0.25, 0.10], "max": [0.50, 0.25, 0.45]},
        "max_joint_update_deg": 1.0,
        "max_takeover_position_error_m": 0.02,
        "rebase_on_intervention": true
      },
      "ggand0_kinematics": {
        "model_path": null,
        "end_effector_site": "gripperframe",
        "ik_damping": 0.1,
        "ik_max_dq_rad": 0.5,
        "locked_joints": [],
        "locked_joint_positions_deg": {},
        "max_takeover_joint_error_deg": 8.0
      },
      "diagnostics": {
        "enabled": true,
        "log_dir": "/home/robot/Codes/lerobot/outputs/hil_diagnostics",
        "console_summary": true
      },
      "observation": {
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "add_ee_pose_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [128, 128]
      },
      "gripper": {"use_gripper": true, "gripper_penalty": 0.0},
      "reset": {
        "fixed_reset_joint_positions": null,
        "reset_time_s": 30.0,
        "control_time_s": 30.0,
        "terminate_on_success": false,
        "success_label_hold_steps": 20,
        "capture_initial_joint_positions": true,
        "initial_position_settle_time_s": 2.0,
        "initial_position_max_delta_deg": 0.5,
        "leader_home_timeout_s": 15.0
      },
      "inverse_kinematics": {
        "urdf_path": "/home/robot/Codes/urdf_files/SO-ARM100/Simulation/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [0.13, -0.17, -0.16],
          "max": [0.35, 0.21, 0.10]
        },
        "end_effector_step_sizes": {"x": 0.01, "y": 0.01, "z": 0.01}
      },
      "max_gripper_pos": 100.0
    }
  },
  "dataset": {
    "repo_id": "local/so101_reward_classifier",
    "task": "so101_task",
    "root": "/home/robot/datasets/so101_reward_classifier",
    "num_episodes_to_record": 50,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
